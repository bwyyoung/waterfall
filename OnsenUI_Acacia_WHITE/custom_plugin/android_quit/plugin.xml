<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
		xmlns:android="http://schemas.android.com/apk/res/android"
		id="liveworkstech.acacia.marketplace-test.android_quit"
		version="0.2.11">
	<name>android_quit</name>
	<description>The coolest Plugin ever implemented</description>
	<license>Apache 2.0</license>
	<keywords>cordova,coolest</keywords>
	<repo></repo>
	<issue></issue>

	<js-module src="www/android_quit.js" name="android_quit">
		<clobbers target="android_quit" />
	</js-module>

	<!-- android -->
	<platform name="android">
		<config-file target="res/xml/config.xml" parent="/*">
			<feature name="android_quit" >
				<param name="android-package" value="android_quit"/>
			</feature>
		</config-file>
		<source-file src="src/android/android_quit.java" target-dir="src/" />
	</platform>

</plugin>